# Large files and results (too big for GitHub)
*.png
*.pdf
*.jpg
*.jpeg
*.gif
*.svg

# Results directories (but keep cognition_results)
*_results/
*_output/
*_figures/
*_analysis/
!cognition_results/

# Standardized output (runscripts + figures)
output/

# Temporary files
*.tmp
*.temp
*.log
*.cache

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Large data files
*.csv
*.json
*.h5
*.hdf5
*.pkl
*.pickle

# Keep only essential code and small config files
!README.md
!*.py
!*.md
!*.yml
!*.yaml
!*.txt
!requirements.txt
!setup.py

# Essential CSV/JSON files for input data and templates
!conflict_input/**/*.csv
!conflict_input/**/*.json
!flee/config_template/**/*.csv
!flee/config_template/**/*.json
!test_data/**/*.csv
!test_data/**/*.json
!conflict_validation/**/*.csv
!conflict_validation/**/*.json
!synthetic/results/**/*.csv
!data/calibration_targets/**/*.csv
!results/fukushima/*.csv

# TMI Day 11 inputs and small run artifacts
!input_data/tmi/**/*.csv
!input_data/tmi/**/*.json
!results/tmi/day12_*.csv
!results/tmi/day12_*.json
!results/tmi/diagnostics_gate_day12.json
!results/tmi/diagnostics_gate_day11.json
!results/tmi/smoke_test/*.csv
!figures/tmi/**/*.png

# TMI Day 13 Sobol sensitivity artifacts
!results/tmi/day13_*.csv
!results/tmi/day13_*.json
!results/tmi/diagnostics_gate_day13.json

# TMI Day 14 CMC calibration + clamp decision artifacts
!results/tmi/day14_*.csv
!results/tmi/day14_*.json
!results/tmi/diagnostics_gate_day14.json

# TMI Day 15 validation: v2 network + re-fit + return + signatures
!input_data/tmi_v2/**/*.csv
!input_data/tmi_v2/**/*.json
!results/tmi/day15_*.csv
!results/tmi/day15_*.json
!results/tmi/diagnostics_gate_day15.json

reports/~$*
